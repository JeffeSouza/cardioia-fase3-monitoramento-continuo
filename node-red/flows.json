    "name": "Conectividade",
    "order": 2,
    "width": 4,
    "height": 2,
    "format": "<style>\n.cardio-status{display:flex;align-items:center;gap:10px;width:100%;padding:4px 8px;box-sizing:border-box}\n.cardio-status i{width:16px;height:16px;border-radius:50%;background:#8a8a8a}\n.cardio-status.on i{background:#2e9e5b}\n.cardio-status.off i{background:#d62828}\n</style>\n<div class=\"cardio-status\" ng-class=\"{on: msg.payload.online === true, off: msg.payload.online === false}\">\n  <i></i><b>{{msg.payload.texto || 'Aguardando status'}}</b>\n</div>\n",
