  {
    "id": "tp_alert",
    "type": "ui_template",
    "z": "cardioia_flow",
    "group": "g_alerta",
    "name": "LED virtual de alerta",
    "order": 1,
    "width": 8,
    "height": 2,
    "format": "<style>\n.cardio-alert{display:flex;align-items:center;gap:14px;width:100%;padding:8px;box-sizing:border-box}\n.cardio-led{width:30px;height:30px;border-radius:50%;flex:none;background:#2e9e5b}\n.cardio-alert.atencao .cardio-led{background:#e0a100}\n.cardio-alert.alerta .cardio-led{background:#d62828;box-shadow:0 0 14px #d62828;animation:cardioPisca 1s infinite}\n.cardio-alert b{display:block;font-size:17px;line-height:1.25}\n.cardio-alert small{opacity:.7}\n@keyframes cardioPisca{50%{opacity:.35}}\n</style>\n<div class=\"cardio-alert {{msg.payload.nivel}}\">\n  <div class=\"cardio-led\"></div>\n  <div><b>{{msg.payload.texto || 'Aguardando dados'}}</b><small ng-if=\"msg.payload.hora\">Leitura das {{msg.payload.hora}}</small></div>\n</div>\n",
    "storeOutMessages": true,
    "fwdInMessages": false,
    "resendOnRefresh": true,
    "templateScope": "local",
    "className": "",
    "x": 760,
    "y": 360,
    "wires": [
