  {
    "id": "fn_process",
    "type": "function",
    "z": "cardioia_flow",
    "name": "Avaliar limites",
    "func": "// Fog: valida a mensagem, aplica os limites clinicos e distribui para o painel.\nconst LIMITS = { bpmMax: 120, bpmMin: 50, tempMax: 38 };\nconst MAX_EVENTS = 8;\n\n// O broker e publico: qualquer pessoa pode publicar neste topico. Por isso, so entram\n// mensagens do dispositivo esperado, com tipos e faixas plausiveis.\nconst d = msg.payload;\nconst faixa = (v, min, max) => typeof v === 'number' && Number.isFinite(v) && v >= min && v <= max;\nconst agora = Date.now() / 1000;\nconst valida = d !== null && typeof d === 'object'\n    && d.device === 'cardioia-7f3a9c'\n    && faixa(d.bpm, 0, 300)\n    && (d.temp === null || faixa(d.temp, -40, 80))\n    && (d.hum === null || faixa(d.hum, 0, 100))\n    && (d.ts === 0 || faixa(d.ts, agora - 7 * 86400, agora + 3600))\n    && faixa(d.queue, 0, 100000)\n    && faixa(d.dropped, 0, 4294967295);\nif (!valida) {\n    node.warn('Mensagem invalida ignorada');\n    return null;\n}\n\nconst backlog = msg.topic.endsWith('/backlog');\nconst ts = d.ts ? d.ts * 1000 : Date.now();  // ts 0 = dispositivo ainda sem NTP\nconst hora = new Date(ts).toLocaleTimeString('pt-BR');\n\n// Regras de alerta\nconst problemas = [], tipos = [];\nif (d.bpm > LIMITS.bpmMax) { tipos.push('T'); problemas.push(`Taquicardia: ${d.bpm} bpm`); }\nif (d.bpm > 0 && d.bpm < LIMITS.bpmMin) { tipos.push('B'); problemas.push(`Bradicardia: ${d.bpm} bpm`); }\nif (d.temp !== null && d.temp > LIMITS.tempMax) { tipos.push('F'); problemas.push(`Febre: ${d.temp} °C`); }\n\n// Saidas: 0 grafico BPM, 1 grafico temp, 2 gauge BPM, 3 gauge temp, 4 gauge umidade,\n//         5 indicador de alerta, 6 telemetria, 7 historico\nconst out = new Array(8).fill(null);\n\n// Graficos recebem tambem o backlog, cada ponto no horario real da captura.\nif (d.bpm > 0) out[0] = { topic: 'BPM', payload: d.bpm, timestamp: ts };\nif (d.temp !== null) out[1] = { topic: 'Temperatura', payload: d.temp, timestamp: ts };\n\n// Historico: registra so o inicio de cada alerta, comparando o tipo e nao o valor.\n// Ordena pelo horario da captura, pois o backlog chega depois de leituras mais recentes.\nconst estado = problemas.join(' | ');\nconst tipoAtual = tipos.join('+');\nconst chave = backlog ? 'ultimoBacklog' : 'ultimoAoVivo';\nif (tipoAtual && tipoAtual !== flow.get(chave)) {\n    const eventos = flow.get('eventos') || [];\n    eventos.push({ ts, hora, texto: estado, origem: backlog ? 'sincronizado' : 'ao vivo' });\n    eventos.sort((a, b) => b.ts - a.ts);\n    eventos.length = Math.min(eventos.length, MAX_EVENTS);\n    flow.set('eventos', eventos);\n    out[7] = { payload: eventos };\n}\nflow.set(chave, tipoAtual);\n\n// Dado antigo nao altera gauges nem o alerta atual: eles mostram o estado do paciente agora.\nif (!backlog) {\n    out[2] = { payload: d.bpm };\n    if (d.temp !== null) out[3] = { payload: d.temp };\n    if (d.hum !== null) out[4] = { payload: d.hum };\n\n    let nivel = 'ok', texto = 'Sinais dentro dos limites';\n    if (problemas.length) { nivel = 'alerta'; texto = estado; }\n    else if (d.bpm === 0) { nivel = 'atencao'; texto = 'Sem sinal de batimento'; }\n    out[5] = { payload: { nivel, texto, hora } };\n}\n\nconst sincronizadas = (flow.get('sincronizadas') || 0) + (backlog ? 1 : 0);\nflow.set('sincronizadas', sincronizadas);\nout[6] = { payload: `Fila no dispositivo: ${d.queue} | Sincronizadas: ${sincronizadas} | Descartadas: ${d.dropped}` };\n\nreturn out;\n",
    "outputs": 8,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 460,
    "y": 230,
    "wires": [
      [
        "ch_bpm"
      ],
      [
        "ch_temp"
      ],
