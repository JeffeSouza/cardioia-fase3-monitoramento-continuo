  {
    "id": "fn_status",
    "type": "function",
    "z": "cardioia_flow",
    "name": "Status do dispositivo",
    "func": "if (msg.payload !== 'online' && msg.payload !== 'offline') return null;\nconst online = msg.payload === 'online';\nmsg.payload = { online, texto: online ? 'Dispositivo online' : 'Dispositivo offline' };\nreturn msg;\n",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 460,
    "y": 620,
    "wires": [
      [
        "tp_status"
      ]
    ]
  },
